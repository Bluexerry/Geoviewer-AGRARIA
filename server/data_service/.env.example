# Data service environment variables — copy this file to .env and fill in the values

FIELDCLIMATE_API_URI=https://api.fieldclimate.com/v2
FIELDCLIMATE_PUBLIC_KEY=your_fieldclimate_public_key
FIELDCLIMATE_PRIVATE_KEY=your_fieldclimate_private_key
DB_NAME=tepro
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
CORS_ORIGINS=http://localhost:3000
